{
  "name": "tolk-inspect-monorepo",
  "private": true,
  "packageManager": "npm@11.6.2",
  "workspaces": ["packages/*", "tests/e2e"],
  "scripts": {
    "build": "npm run build:wasm && npm run build:ts",
    "build:wasm": "bash ./scripts/build-wasm.sh",
    "build:ts": "npm run build --workspace tolk-inspect",
    "check:versions": "node ./scripts/check-versions.mjs",
    "check:format": "cargo fmt --all -- --check",
    "check:clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "pack:dry-run": "npm pack --dry-run --workspace tolk-inspect",
    "release:check": "npm run check:versions && npm run check:format && npm run check:clippy && npm test && npm run pack:dry-run",
    "test": "bash ./scripts/test-all.sh",
    "test:rust": "cargo test --workspace",
    "test:e2e": "npm run test --workspace tolk-inspect-e2e",
    "test:compat": "bash ./scripts/test-acton-1.1.sh"
  },
  "devDependencies": {
    "typescript": "5.9.2"
  }
}
